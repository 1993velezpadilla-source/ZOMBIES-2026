+namespace {
+using video::IImage;
+using video::ITexture;
+using video::IVideoDriver;
+
+constexpr u64 GPU_BUDGET = 512ULL * 1024 * 1024;
+constexpr u32 MAX_DIMENSION = 4096;
+constexpr u32 MAX_REQUESTS = 32;
+constexpr u32 MAX_DECODED = 2;
+constexpr u32 ANIMATION_LOOKAHEAD = 6;
+
+struct MaterialFile {
+	u32 width, height;
+	u32 preview_width, preview_height;
+	std::vector<std::string> frames;
+};
+
+struct AnimationFrame {
+	size_t start, index_start, end;
+	u32 count, index;
+};
+
+std::optional<AnimationFrame> findAnimationFrame(const std::string &expression)
+{
+	constexpr std::string_view marker = "^[verticalframe:";
+	const size_t start = expression.rfind(marker);
+	if (start == std::string::npos || (start && expression[start - 1] == '\\'))
+		return std::nullopt;
+
+	const char *begin = expression.data();
+	const char *end = begin + expression.size();
+	u32 count = 0, index = 0;
+	auto count_end = std::from_chars(begin + start + marker.size(), end, count);
+	if (count_end.ec != std::errc() || count_end.ptr == end || *count_end.ptr != ':' ||
+			count < 2 || count > 128)
+		return std::nullopt;
+	auto index_end = std::from_chars(count_end.ptr + 1, end, index);
+	if (index_end.ec != std::errc() || index >= count ||
+			(index_end.ptr != end && *index_end.ptr != '^' && *index_end.ptr != ')'))
+		return std::nullopt;
+	return AnimationFrame{start, size_t(count_end.ptr + 1 - begin),
+			size_t(index_end.ptr - begin), count, index};
+}
+
+bool isAssetPath(const std::string &path)
+{
+	return !path.empty() && path.front() != '/' && path.find("..") == std::string::npos &&
+			path.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+					"0123456789_-/ .") == std::string::npos;
+}
+
+std::vector<std::string> fields(const std::string &line)
+{
+	std::vector<std::string> result;
+	size_t start = 0;
+	for (size_t tab; (tab = line.find('\t', start)) != std::string::npos; start = tab + 1)
+		result.emplace_back(line.substr(start, tab - start));
+	result.emplace_back(line.substr(start));
+	return result;
+}
+
+bool parseU32(const std::string &field, u32 &value)
+{
+	auto end = field.data() + field.size();
+	auto result = std::from_chars(field.data(), end, value);
+	return result.ec == std::errc() && result.ptr == end && value > 0;
+}
+} // namespace
+
+struct WorldDetail::State
+{
+	struct Entry {
+		std::string expression;
+		ITexture *texture = nullptr;
+		u64 bytes = 0;
+		u64 last_draw = 0;
+		u64 requested = 0;
+		bool queued = false;
+		bool failed = false;
+		bool logged = false;
+		const std::vector<ITexture *> *animation = nullptr;
+		u32 animation_index = 0;
+	};
+
+	struct Request {
+		ITexture *preview;
+		std::string expression;
+	};
+
+	struct Result {
+		ITexture *preview;
+		irr_ptr<IImage> image;
+	};
+
+	State(IVideoDriver *driver, std::string path)
+		: driver(driver), game_path(std::move(path)), detail_path(game_path + "/world_detail36/")
+	{}
+
+	~State()
+	{
+		{
+			std::lock_guard lock(mutex);
+			stop = true;
+		}
+		wake.notify_one();
+		if (worker.joinable())
+			worker.join();
+		if (attached) {
+			driver->setMaterialTextureResolver({});
+			actionstream << "World detail: " << uploads << " uploads; "
+					<< peak_resident_bytes << " bytes peak; " << evictions
+					<< " evictions\n";
+		}
+		for (auto &pair : entries)
+			evict(pair.second);
+	}
+
+	bool readIndex()
+	{
+		std::ifstream index(detail_path + "index.tsv");
+		std::string line;
+		if (!std::getline(index, line) || line != "xz-world-detail-1")
+			return false;
+		while (std::getline(index, line)) {
+			auto row = fields(line);
+			MaterialFile file{};
+			if (row.size() < 6 || row.size() > 133 ||
+					!parseU32(row[1], file.width) || !parseU32(row[2], file.height) ||
+					!parseU32(row[3], file.preview_width) || !parseU32(row[4], file.preview_height) ||
+					std::min(file.width, file.height) < 1024 ||
+					std::max(file.width, file.height) > MAX_DIMENSION)
+				return false;
+			for (size_t i = 5; i < row.size(); ++i) {
+				if (!isAssetPath(row[i]))
+					return false;
+				file.frames.push_back(detail_path + row[i]);
+			}
+			if (!files.emplace(row.front(), std::move(file)).second)
+				return false;
+		}
+		std::ifstream preview_index(detail_path + "previews.tsv");
+		while (std::getline(preview_index, line)) {
+			auto row = fields(line);
+			if (row.size() == 2 && isAssetPath(row[1]))
+				previews.emplace(row[0], game_path + "/" + row[1]);
+		}
+		return !files.empty() && !previews.empty();
+	}
+
+	const MaterialFile *findFirstSource(std::string_view expression) const
+	{
+		constexpr auto name_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+				"0123456789_.-";
+		size_t start = 0;
+		while ((start = expression.find_first_of(name_chars, start)) != std::string_view::npos) {
+			size_t end = expression.find_first_not_of(name_chars, start);
+			if (end == std::string_view::npos)
+				end = expression.size();
+			auto it = files.find(std::string(expression.substr(start, end - start)));
+			if (it != files.end())
+				return &it->second;
+			start = end;
+		}
+		return nullptr;
+	}
+
+	IImage *decode(const MaterialFile &file, u32 frame) const
+	{
+		const auto &path = file.frames[frame];
+		if (path.size() < 5 || path.compare(path.size() - 5, 5, ".webp") != 0)
+			return driver->createImageFromFile(path.c_str());
+
+		std::ifstream stream(path, std::ios::binary | std::ios::ate);
+		const auto bytes = stream.tellg();
+		if (bytes <= 0 || bytes > 16 * 1024 * 1024)
+			return nullptr;
+		std::vector<u8> data(static_cast<size_t>(bytes));
+		stream.seekg(0);
+		if (!stream.read(reinterpret_cast<char *>(data.data()), bytes))
+			return nullptr;
+
+		int width = 0, height = 0;
+		if (!WebPGetInfo(data.data(), data.size(), &width, &height) ||
+				width != static_cast<int>(file.width) || height != static_cast<int>(file.height))
+			return nullptr;
+
+		irr_ptr<IImage> image(driver->createImage(video::ECF_A8R8G8B8, {file.width, file.height}));
+		if (!image || !WebPDecodeBGRAInto(data.data(), data.size(),
+				static_cast<u8 *>(image->getData()), image->getImageDataSizeInBytes(), image->getPitch()))
+			return nullptr;
+		return image.release();
+	}
+
+	irr_ptr<IImage> compose(const std::string &original) const
+	{
+		const MaterialFile *first = findFirstSource(original);
+		if (!first)
+			return {};
+
+		auto animation = findAnimationFrame(original);
+		bool split_frames = animation && first->frames.size() == animation->count;
+		bool positioned = original.find("[combine:") != std::string::npos ||
+				original.find("[resize:") != std::string::npos ||
+				original.find("[fill:") != std::string::npos;
+		// The original preview strip defines timing. Read just the requested
+		// full-sized frame so neither a decoded strip nor a GPU atlas is needed.
+		if (first->frames.size() > 1 && !split_frames && !positioned)
+			return {};
+		std::string expression = original;
+		if (split_frames)
+			expression.erase(animation->start, animation->end - animation->start);
+		const double scale = positioned ? double(first->width) / first->preview_width : 1.0;
+
+		bool missing = false;
+		ImageSource source;
+		source.configureDetail([&](const std::string &name) -> IImage * {
+			auto known = files.find(name);
+			IImage *image = nullptr;
+			u32 preview_w = 0, preview_h = 0;
+			if (known != files.end()) {
+				const MaterialFile &file = known->second;
+				if (file.frames.size() > 1 &&
+						((split_frames && file.frames.size() != animation->count) ||
+						 (!split_frames && !positioned))) {
+					missing = true;
+					return nullptr;
+				}
+				const u32 index = split_frames && file.frames.size() > 1 ? animation->index : 0;
+				image = decode(file, index);
+				preview_w = file.preview_width;
+				preview_h = file.preview_height / file.frames.size();
+			} else {
+				auto preview = previews.find(name);
+				std::string path = preview == previews.end() ? getTexturePath(name) : preview->second;
+				if (!path.empty())
+					image = driver->createImageFromFile(path.c_str());
+				if (image) {
+					preview_w = image->getDimension().Width;
+					preview_h = image->getDimension().Height;
+				}
+			}
+			if (!image) {
+				missing = true;
+				return nullptr;
+			}
+			if (!positioned)
+				return image;
+
+			// Keep every source on the same coordinate grid in a crop or atlas.
+			const u32 w = std::max(1L, std::lround(preview_w * scale));
+			const u32 h = std::max(1L, std::lround(preview_h * scale));
+			if (std::max(w, h) > MAX_DIMENSION) {
+				image->drop();
+				missing = true;
+				return nullptr;
+			}
+			if (image->getDimension() == core::dimension2du(w, h))
+				return image;
+			IImage *scaled = driver->createImage(video::ECF_A8R8G8B8, {w, h});
+			image->copyToScaling(scaled);
+			image->drop();
+			return scaled;
+		}, scale);
+
+		std::set<std::string> unused;
+		irr_ptr<IImage> image(source.generateImage(expression, unused));
+		if (missing || !image)
+			return {};
+		return image;
+	}
+
+	void work()
+	{
+		std::unique_lock lock(mutex);
+		while (true) {
+			wake.wait(lock, [&] { return stop || (!requests.empty() && decoded.size() < MAX_DECODED); });
+			if (stop)
+				return;
+			Request request = std::move(requests.front());
+			requests.pop_front();
+			lock.unlock();
+
+			irr_ptr<IImage> image;
+			try {
+				image = compose(request.expression);
+			} catch (const std::exception &e) {
+				warningstream << "World detail: image preparation failed: " << e.what() << '\n';
+			}
+
+			lock.lock();
+			if (!stop)
+				decoded.push_back({request.preview, std::move(image)});
+		}
+	}
+
+	void enqueue(ITexture *preview, Entry &entry, bool priority)
+	{
+		entry.requested = frame;
+		if (entry.queued || entry.failed || entry.texture)
+			return;
+		std::lock_guard lock(mutex);
+		if (requests.size() == MAX_REQUESTS)
+			return;
+		if (priority)
+			requests.push_front({preview, entry.expression});
+		else
+			requests.push_back({preview, entry.expression});
+		entry.queued = true;
+		wake.notify_one();
+	}
+
+	ITexture *resolve(ITexture *preview)
+	{
+		auto it = entries.find(preview);
+		if (it == entries.end())
+			return preview;
+
+		auto &entry = it->second;
+		if (entry.last_draw != frame) {
+			entry.last_draw = frame;
+			enqueue(preview, entry, true);
+			if (entry.animation) {
+				const auto &frames = *entry.animation;
+				for (u32 i = 1; i <= ANIMATION_LOOKAHEAD && i < frames.size(); ++i) {
+					auto *next = frames[(entry.animation_index + i) % frames.size()];
+					auto candidate = entries.find(next);
+					if (candidate != entries.end())
+						enqueue(next, candidate->second, false);
+				}
+			}
+		}
+		if (!entry.texture)
+			return preview;
+		if (!entry.logged) {
+			entry.logged = true;
+			const auto size = entry.texture->getSize();
+			verbosestream << "World detail bound " << size.Width << 'x' << size.Height
+					<< " " << entry.expression << '\n';
+		}
+		return entry.texture;
+	}
+
+	void evict(Entry &entry)
+	{
+		if (!entry.texture)
+			return;
+		driver->removeTexture(entry.texture);
+		resident_bytes -= entry.bytes;
+		entry.texture = nullptr;
+		entry.bytes = 0;
+	}
+
+	void step()
+	{
+		++frame;
+		Result result{};
+		{
+			std::lock_guard lock(mutex);
+			if (decoded.empty())
+				return;
+			result = std::move(decoded.front());
+			decoded.pop_front();
+			wake.notify_one();
+		}
+
+		auto it = entries.find(result.preview);
+		if (it == entries.end())
+			return;
+		auto &entry = it->second;
+		entry.queued = false;
+		if (frame - entry.requested > 120)
+			return;
+		if (!result.image) {
+			entry.failed = true;
+			verbosestream << "World detail could not compose " << entry.expression << '\n';
+			return;
+		}
+
+		const auto size = result.image->getDimension();
+		const u64 bytes = (u64(size.Width) * size.Height * 16 + 2) / 3;
+		const auto preview_size = result.preview->getOriginalSize();
+		const double aspect = double(size.Width) * preview_size.Height /
+				(double(size.Height) * preview_size.Width);
+		const auto max_size = driver->getLimits().MaxTextureSize;
+		if (!size.Width || !size.Height || size.Width > max_size || size.Height > max_size ||
+				bytes > GPU_BUDGET || std::abs(aspect - 1.0) > 0.025) {
+			entry.failed = true;
+			verbosestream << "World detail incompatible dimensions " << size.Width << 'x' << size.Height
+					<< " for " << preview_size.Width << 'x' << preview_size.Height
+					<< " " << entry.expression << '\n';
+			return;
+		}
+
+		while (resident_bytes + bytes > GPU_BUDGET) {
+			Entry *oldest = nullptr;
+			for (auto &pair : entries) {
+				auto &candidate = pair.second;
+				if (candidate.texture && (!oldest || candidate.last_draw < oldest->last_draw))
+					oldest = &candidate;
+			}
+			if (!oldest || (oldest->last_draw && frame - oldest->last_draw < 2))
+				return;
+			evict(*oldest);
+			++evictions;
+		}
+
+		// GPU creation stays on the render thread. The name is separate from the
+		// ordinary media so its cache and its existing users are unaffected.
+		const std::string name = "__xz_world_detail_" + std::to_string(++texture_number);
+		entry.texture = driver->addTexture(name.c_str(), result.image.get());
+		if (!entry.texture || entry.texture->getSize() != size) {
+			if (entry.texture)
+				driver->removeTexture(entry.texture);
+			entry.texture = nullptr;
+			entry.failed = true;
+			warningstream << "World detail: full size upload failed for " << entry.expression << '\n';
+			return;
+		}
+		entry.bytes = bytes;
+		resident_bytes += bytes;
+		peak_resident_bytes = std::max(peak_resident_bytes, resident_bytes);
+		++uploads;
+	}
+
+	IVideoDriver *const driver;
+	const std::string game_path;
+	const std::string detail_path;
+	std::unordered_map<std::string, MaterialFile> files;
+	std::unordered_map<std::string, std::string> previews;
+	std::unordered_map<ITexture *, Entry> entries;
+	std::unordered_map<std::string, std::vector<ITexture *>> animations;
+	u64 frame = 1;
+	u64 resident_bytes = 0;
+	u64 texture_number = 0;
+	u64 uploads = 0;
+	u64 evictions = 0;
+	u64 peak_resident_bytes = 0;
+	bool attached = false;
+
+	std::thread worker;
+	std::mutex mutex;
+	std::condition_variable wake;
+	std::deque<Request> requests;
+	std::deque<Result> decoded;
+	bool stop = false;
+};
+
+WorldDetail::WorldDetail(std::unique_ptr<State> state) : m_state(std::move(state))
+{}
+WorldDetail::~WorldDetail() = default;
+
+std::unique_ptr<WorldDetail> WorldDetail::create(IVideoDriver *driver, const std::string &path)
+{
+	if (path.empty())
+		return {};
+	auto state = std::make_unique<State>(driver, path);
+	if (!state->readIndex())
+		return {};
+	auto *impl = state.get();
+	state->attached = driver->setMaterialTextureResolver([impl](ITexture *preview) {
+		return impl->resolve(preview);
+	});
+	if (!state->attached)
+		return {};
+	try {
+		state->worker = std::thread([impl] { impl->work(); });
+	} catch (const std::system_error &e) {
+		warningstream << "World detail: could not start decoder: " << e.what() << '\n';
+		return {};
+	}
+	actionstream << "World detail: " << state->files.size()
+			<< " native materials; " << (GPU_BUDGET / (1024 * 1024))
+			<< " MiB detail texture budget\n";
+	return std::unique_ptr<WorldDetail>(new WorldDetail(std::move(state)));
+}
+
+bool WorldDetail::hasSource(const std::string &expression) const
+{
+	return m_state->findFirstSource(expression);
+}
+
+void WorldDetail::add(ITexture *preview, const std::string &expression,
+		const std::set<std::string> &sources)
+{
+	// Small particle crops are sprites, not a surface to stream.
+	const auto preview_size = preview ? preview->getOriginalSize() : core::dimension2du();
+	if (!preview || std::max(preview_size.Width, preview_size.Height) <= 8 || expression.size() > 8192 ||
+			std::none_of(sources.begin(), sources.end(), [&](const auto &name) {
+				return m_state->files.count(name) > 0;
+			}))
+		return;
+	auto [it, inserted] = m_state->entries.try_emplace(preview);
+	if (!inserted)
+		return;
+	auto &entry = it->second;
+	entry.expression = expression;
+	if (auto animation = findAnimationFrame(expression)) {
+		std::string group = expression;
+		group.erase(animation->index_start, animation->end - animation->index_start);
+		auto &frames = m_state->animations[group];
+		frames.resize(animation->count);
+		frames[animation->index] = preview;
+		entry.animation = &frames;
+		entry.animation_index = animation->index;
+	}
+	verbosestream << "World detail registered " << expression << '\n';
+#ifndef __ANDROID__
+	// Opt-in verification uses the same composer without scheduling GPU uploads.
+	static const bool audit = std::getenv("XZ_WORLD_DETAIL_AUDIT") != nullptr;
+	if (audit) {
+		auto image = m_state->compose(expression);
+		const auto old_size = preview->getOriginalSize();
+		const auto size = image ? image->getDimension() : core::dimension2du();
+		actionstream << "World detail audit " << size.Width << 'x' << size.Height
+				<< " (preview " << old_size.Width << 'x' << old_size.Height
+				<< ") " << expression << '\n';
+	}
+#endif
+}
+
+void WorldDetail::invalidate(ITexture *preview)
+{
+	auto it = m_state->entries.find(preview);
+	if (it == m_state->entries.end())
+		return;
+	m_state->evict(it->second);
+	m_state->entries.erase(it);
+}
+
+void WorldDetail::step()
+{
+	m_state->step();
+}
